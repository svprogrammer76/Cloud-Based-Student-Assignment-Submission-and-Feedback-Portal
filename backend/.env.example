FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=assignment-submissions
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MAX_UPLOAD_BYTES=16777216
ALLOW_LATE_SUBMISSIONS=true
ALLOW_RESUBMISSIONS=true
LOCAL_STORAGE_DIR=
# No-billing emulator profile: set the demo project ID, local_storage_dir=local_uploads,
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 and FIRESTORE_EMULATOR_HOST=127.0.0.1:8080.
# For hosted Firebase, leave emulator hosts/local storage blank and use runtime identity or local ADC.
